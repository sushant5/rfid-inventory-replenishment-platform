APP_ENV=development

# Runtime uses a non-superuser/NOBYPASSRLS role. Alembic alone uses the owner URL.
DATABASE_URL=postgresql+psycopg://abacus_app:replace-me@localhost:5432/abacus
MIGRATION_DATABASE_URL=postgresql+psycopg://abacus_owner:replace-me@localhost:5432/abacus
APPLICATION_DATABASE_ROLE=abacus_app

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=abacus-assignment
JWT_AUDIENCE=abacus-api
ACCESS_TOKEN_MINUTES=15
PLATFORM_API_KEY=replace-with-a-random-platform-key

LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_WINDOW_SECONDS=60
LOGIN_THROTTLE_IP_LIMIT=30
LOGIN_THROTTLE_ACCOUNT_LIMIT=5
LOGIN_THROTTLE_MAX_ENTRIES=10000

WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=5
RFID_MOVE_CONFIRMATION_READS=3
RFID_MOVE_CONFIRMATION_WINDOW_SECONDS=10
RFID_REMOVAL_TIMEOUT_SECONDS=1800
RFID_REMOVAL_SWEEP_INTERVAL_SECONDS=60
RFID_LAST_SEEN_FLUSH_SECONDS=30
RFID_CONFIDENCE_HALF_LIFE_SECONDS=1800
RFID_MAX_FUTURE_SKEW_SECONDS=300
CONNECTIVITY_LIVE_WINDOW_SECONDS=120
CONNECTIVITY_STALE_WINDOW_SECONDS=600
REPLENISHMENT_MINIMUM_CONFIDENCE=0.70

BUILD_SHA=local
BOOTSTRAP_TENANT_CODE=orange
BOOTSTRAP_TENANT_NAME=Orange
BOOTSTRAP_ADMIN_EMAIL=reviewer@orange.example
BOOTSTRAP_ADMIN_DISPLAY_NAME=Assignment Reviewer
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-reviewer-password
